Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to internal directories
    RewriteRule ^(config|core|includes|modules|database|storage|tests|integrations)/ - [F,L]

    # Block hidden files (.env, .git, etc.)
    RewriteRule ^\. - [F,L]

    # Clean URLs for Public pages
    RewriteRule ^services/?$ /public/index.php?page=services [L,QSA]
    RewriteRule ^faq/?$ /public/index.php?page=faq [L,QSA]
    RewriteRule ^about/?$ /public/index.php?page=about [L,QSA]
    RewriteRule ^contact/?$ /public/index.php?page=contact [L,QSA]
    RewriteRule ^terms/?$ /public/index.php?page=terms [L,QSA]
    RewriteRule ^privacy/?$ /public/index.php?page=privacy [L,QSA]

    # Clean URLs for User Panel routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^user/([a-zA-Z0-9/_-]+)$ /user/index.php?page=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
